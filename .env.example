# =============================================================================
# Supabase configuration
# =============================================================================
#
# Only the `anon` (publishable, RLS-protected) key belongs in env files.
# NEVER put a `service_role` key in any .env file — it bypasses RLS.
#
# Quick start
# -----------
#   cp .env.example .env      # active env (gitignored)
#   npm start                 # reads .env → talks to Supabase
# =============================================================================

# Project: aixdpmglcanvuscorylw (serves both local dev and production for now)
VITE_SUPABASE_URL=https://aixdpmglcanvuscorylw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFpeGRwbWdsY2FudnVzY29yeWx3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkyODg0NzMsImV4cCI6MjEwNDg2NDQ3M30.51612A6nJx8fD551rqjWY1tAmDsCwQg9mcGjtOnwc5o

# ANALYTICS — PostHog Cloud. Leave blank to disable analytics (local dev default).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# FEATURE FLAGS
# VITE_ENABLE_MEMBERSHIP=true
# VITE_ENABLE_VOUCHERS=true
# VITE_ENABLE_CUSTOMER_REFERRALS=true
# VITE_ENABLE_OUTREACH=true
# VITE_ENABLE_PLATFORM_ADMIN=true
# VITE_ENABLE_CONSULTATION=true
# Local phone testing (see README, scripts/dev-phone.sh): dev server forwards /sb to local Supabase.
# VITE_SUPABASE_URL=/sb
# VITE_DEV_SUPABASE_PROXY_TARGET=http://127.0.0.1:54321
# VITE_PUBLIC_APP_URL=https://<tunnel-address>   # written by scripts/dev-phone.sh
# VITE_VAPID_PUBLIC_KEY=   # public Web Push key (see supabase/functions/.env.example)
